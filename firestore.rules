rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function mref() { return /databases/$(database)/documents/members/$(mail()); }
    function hasM() { return exists(mref()); }
    function mdoc() { return get(mref()).data; }
    function isAdmin() {
      return signedIn() && (
        mail() == 'hooday@gmail.com' ||
        (hasM() && mdoc().role == 'admin'));
    }
    // Ekipa (member/admin): zawsze, bez ograniczeń poziomu.
    function isCrew() { return signedIn() && (isAdmin() || (hasM() && mdoc().role != 'supporter')); }
    // Poziomy dostępu (decyzja 11.11.2026): 0 = każdy zalogowany (darmowy i Poziom I), 1 = Poziom II, 2 = Poziom III.
    // Wspierający: poziom z pola "level" (brak pola = 2, dawni wspierający), ważny do daty "until" (karencja 3 dni
    // jest wliczona w "until" przez synchronizację). Po "until" poziom spada do 0.
    function level() {
      return !signedIn() ? -1 :
        (isCrew() ? 2 :
        (!hasM() ? 0 :
        ((mdoc().get('until', null) != null && mdoc().until > request.time) ? mdoc().get('level', 2) : 0)));
    }
    match /members/{id} {
      allow read: if signedIn() && (id == mail() || isAdmin());
      allow write: if isAdmin();
    }
    match /accessRequests/{id} {
      allow read: if signedIn() && (id == mail() || isAdmin());
      allow create, update: if signedIn() && id == mail()
        && request.resource.data.keys().hasOnly(['email','nick','at','status'])
        && request.resource.data.email == mail()
        && request.resource.data.status == 'pending'
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 80;
      allow write: if isAdmin();
    }
    match /data/{id} {
      // Dane bieżące i tła: każdy zalogowany (poziom darmowy). Historia zawodników 2021–2025 (Rozwój): Poziom III.
      // Pozostałe dokumenty (kopie zapasowe itp.): tylko ekipa.
      allow read: if signedIn() && (
        id in ['stats', 'bg', 'bgV', 'bgS', 'bgSV'] ||
        (id.matches('history_.*') && level() >= 2) ||
        isCrew());
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
